{
  "kind": "collectionType",
  "collectionName": "zones",
  "info": {
    "singularName": "zone",
    "pluralName": "zones",
    "displayName": "Zone",
    "description": "Zone master list managed by super admins"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "code": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "members": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::member.member",
      "mappedBy": "zone"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
